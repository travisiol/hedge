# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://hedge.example

# --- Launch ---------------------------------------------------------------
# Every address below is unset on purpose. An address that is not real must
# never be able to reach a build: unset renders as an em dash, and Buy stays
# disabled with the reason written on the button.
#
# `LIVE=true` is not enough on its own — the site needs the flag AND the token
# AND the vault before anything reads as live, because a token with no vault
# behind it pays nothing on red days either.
NEXT_PUBLIC_HEDGE_LIVE=false
NEXT_PUBLIC_HEDGE_TOKEN_ADDRESS=
NEXT_PUBLIC_HEDGE_VAULT_ADDRESS=

# Posts the daily close of NVDA and the S&P 500. Setting this ticks the first
# box in §03; the other three are ticked by humans, not by env vars.
NEXT_PUBLIC_HEDGE_ORACLE_ADDRESS=

# USDG on this chain. Verify against Paxos before setting it — a wrong address
# here pays holders in something that is not a dollar.
NEXT_PUBLIC_HEDGE_USDG_ADDRESS=

# Where Buy points once there is something to buy.
NEXT_PUBLIC_HEDGE_BUY_URL=

# One line each, only once decided. Both render as "—" while unset.
# e.g. "1.5% of every buy and sell"
NEXT_PUBLIC_HEDGE_FEE_DESCRIPTION=
# e.g. "35% of the vault, scaled to the size of the fall"
NEXT_PUBLIC_HEDGE_PAYOUT_RULE=

# --- Chain ----------------------------------------------------------------
# Defaults are the values probed live on 2026-09-02; override if they move.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=
